# Loaded by `npm run build` only — never by `npm run dev`, so local work does
# not report itself into the live property.
#
# A GA4 Measurement ID is public: it ships in the client bundle and is readable
# in the page source of every site that uses GA. Committing it means a deploy
# cannot silently lose tracking because a host dashboard variable was missed.
# An environment variable of the same name still takes precedence if set.
VITE_GA_MEASUREMENT_ID=G-2FXV5QWN3N
